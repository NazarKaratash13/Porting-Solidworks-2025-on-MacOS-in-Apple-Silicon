+/* Return an exact, disjoint union of cuts, restricted to the client.
+ * Unlike a bounding-box merge, this preserves the empty corners of an L.
+ * Caller owns holes and must clear it even on failure. */
+static inline bool gl_clip_union_in_client(struct gl_clip_region *holes, RECT client,
+                                          const RECT *cuts, size_t count)
+{
+    struct gl_clip_region visible = {0};
+    size_t i;
+    bool ok = gl_clip_push(&visible, client);
+    for (i = 0; ok && i < count && visible.count; i++)
+        ok = gl_clip_subtract(&visible, cuts[i]);
+    if (ok) ok = gl_clip_complement(holes, client, &visible);
+    gl_clip_clear(&visible);
+    return ok;
+}
