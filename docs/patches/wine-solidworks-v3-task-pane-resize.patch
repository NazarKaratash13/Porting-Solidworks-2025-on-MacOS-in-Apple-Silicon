+static BOOL sw_taskpane_layout_enabled(void)
+{
+    const char *value = getenv( "WIN32U_SW_TASKPANE_LAYOUT" );
+    return value && !strcmp( value, "1" );
+}
+
+static BOOL sw_resize_frame( HWND hwnd )
+{
+    static const WCHAR name[] = {'S','O','L','I','D','W','O','R','K','S',' ','S','t','u','d','e','n','t',' ',
+                                 'E','d','i','t','i','o','n',0};
+    WCHAR title[96];
+    DWORD style = get_window_long( hwnd, GWL_STYLE );
+
+    return (style & (WS_CHILD | WS_THICKFRAME)) == WS_THICKFRAME &&
+           NtUserInternalGetWindowText( hwnd, title, ARRAY_SIZE(title) ) >= ARRAY_SIZE(name) - 1 &&
+           !wcsncmp( title, name, ARRAY_SIZE(name) - 1 );
+}
+
+/* Keep room for PropertyManager and the model beside the pinned dock. */
+static LONG sw_minimum_frame_width( HWND hwnd, UINT coordinates_dpi )
+{
+    UINT raw_dpi, dpi = coordinates_dpi ? coordinates_dpi : get_win_monitor_dpi( hwnd, &raw_dpi );
+    HWND child;
+    RECT rect, top;
+    LONG minimum = muldiv( 820, dpi, 96 );
+    LONG reserve = muldiv( 550, dpi, 96 );
+
+    for (child = NtUserGetWindowRelative( hwnd, GW_CHILD ); child;
+         child = NtUserGetWindowRelative( child, GW_HWNDNEXT ))
+    {
+        /* The outer MFC dock bar owns the pinned Task Pane (control 59465). */
+        if (get_window_long( child, GWLP_ID ) != 59421 || !NtUserIsWindowVisible( child ) ||
+            !get_window_rect( child, &rect, coordinates_dpi )) continue;
+        minimum = max( minimum, reserve + rect.right - rect.left );
+        break;
+    }
+
+    if (get_window_rect( hwnd, &top, coordinates_dpi ))
+    {
+        MONITORINFO monitor = monitor_info_from_rect( top, coordinates_dpi );
+        LONG available = monitor.rcWork.right - monitor.rcWork.left;
+        if (available > 0) minimum = min( minimum, available );
+    }
+    return minimum;
+}
+
+static BOOL sw_is_auto_hider( HWND hwnd )
+{
+    static const WCHAR auto_hider[] = {'A','u','t','o',' ','H','i','d','e','r',0};
+    WCHAR title[32];
+
+    return NtUserInternalGetWindowText( hwnd, title, ARRAY_SIZE(title) ) &&
+           !wcscmp( title, auto_hider );
+}
+
+static BOOL sw_taskpane_window( HWND hwnd )
+{
+    HWND parent = hwnd, root = NtUserGetAncestor( hwnd, GA_ROOT );
+
+    if (!root || root == hwnd || !sw_resize_frame( root )) return FALSE;
+    while (parent && parent != root)
+    {
+        DWORD_PTR id = get_window_long( parent, GWLP_ID );
+        if (id == 59465 || id == 59421) return TRUE;
+        if (sw_is_auto_hider( parent )) return TRUE;
+        parent = NtUserGetAncestor( parent, GA_PARENT );
+    }
+    return FALSE;
+}
+
+/* MFC can request an Auto Hider as wide as the MDI client on restore. */
+static void sw_fit_auto_hider( WINDOWPOS *winpos )
+{
+    static const WCHAR mdi_name[] = {'s','w','M','d','i','C','l','i','e','n','t',0};
+    WCHAR class_name[32];
+    UNICODE_STRING name = {0, sizeof(class_name), class_name};
+    HWND parent, root;
+    RECT client;
+    UINT raw_dpi, dpi = get_thread_dpi(), scale;
+    LONG width, limit;
+
+    if (winpos->flags & (SWP_NOSIZE | SWP_NOMOVE | SWP_HIDEWINDOW)) return;
+    if (!sw_is_auto_hider( winpos->hwnd )) return;
+    if (!(parent = NtUserGetAncestor( winpos->hwnd, GA_PARENT )) ||
+        !NtUserGetClassName( parent, FALSE, &name ) || wcscmp( class_name, mdi_name )) return;
+    if (!(root = NtUserGetAncestor( parent, GA_ROOT )) || !sw_resize_frame( root )) return;
+    if (!get_client_rect( parent, &client, dpi ) || (width = client.right - client.left) <= 0) return;
+
+    scale = dpi ? dpi : get_win_monitor_dpi( parent, &raw_dpi );
+    limit = min( muldiv( 420, scale, 96 ), max( width - muldiv( 550, scale, 96 ), width / 3 ));
+    if (limit <= 0 || (winpos->cx >= 0 && winpos->cx <= limit)) return;
+
+    TRACE( "SOLIDWORKS Auto Hider %p width %d -> %ld (MDI %ld, DPI %u)\n",
+           winpos->hwnd, winpos->cx, (long)limit, (long)width, scale );
+    winpos->cx = limit;
+    winpos->x = client.right - limit;
+}
