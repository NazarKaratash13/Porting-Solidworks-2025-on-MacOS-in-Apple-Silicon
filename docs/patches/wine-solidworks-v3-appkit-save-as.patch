+static BOOL sw_native_save_as( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    static const WCHAR name[] = {'S','O','L','I','D','W','O','R','K','S',' ','S','t','u','d','e','n','t',' ',
+                                 'E','d','i','t','i','o','n',0};
+    const char *enabled;
+    WCHAR title[64];
+    DWORD style;
+
+    /* Leave the original dialog available for formats and export options. */
+    if (msg != WM_COMMAND || (wparam != 0xe104 && wparam != 0x1e104) || lparam) return FALSE;
+    if (!(enabled = getenv( "WINEMAC_SW_FILES_PID" )) || !*enabled) return FALSE;
+    style = get_window_long( hwnd, GWL_STYLE );
+    if ((style & (WS_CHILD | WS_DISABLED | WS_SYSMENU)) != WS_SYSMENU ||
+        NtUserGetWindowRelative( hwnd, GW_OWNER ) || (NtUserGetKeyState( VK_SHIFT ) & 0x8000))
+        return FALSE;
+
+    return NtUserInternalGetWindowText( hwnd, title, ARRAY_SIZE(title) ) >= ARRAY_SIZE(name) - 1 &&
+           !wcsncmp( title, name, ARRAY_SIZE(name) - 1 ) &&
+           !user_driver->pSysCommand( hwnd, WINE_SW_NATIVE_SAVE_AS, 0, NULL );
+}
