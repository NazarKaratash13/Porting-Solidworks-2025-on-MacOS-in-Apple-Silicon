+static NSMenu *sw_add_menu(NSMenu *menu, NSString *title)
+{
+    NSMenuItem *root = [[[NSMenuItem alloc] init] autorelease];
+    NSMenu *submenu = [[[NSMenu alloc] initWithTitle:title] autorelease];
+    root.title = title;
+    root.submenu = submenu;
+    [menu addItem:root];
+    return submenu;
+}
+
+static NSMenuItem *sw_add_item(NSMenu *menu, id target, NSString *title, SEL action, NSString *key)
+{
+    NSMenuItem *item = [menu addItemWithTitle:title action:action keyEquivalent:key];
+    item.target = target;
+    return item;
+}
+
+static void sw_add_command(NSMenu *menu, id target, NSString *title, NSInteger command)
+{
+    sw_add_item(menu, target, title, @selector(swRunMacCommand:), @"").tag = command;
+}
