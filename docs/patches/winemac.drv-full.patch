 /***********************************************************************
+ *              macdrv_set_view_clip
+ *
+ * Punch the given rectangles out of the view by masking its layer, so the
+ * window surface underneath shows through.  This clips the GL content
+ * without reading it back.  The rectangles and the surface size are in
+ * window pixels; they are scaled to the view's own (point) coordinates
+ * here, which keeps HiDPI correct.
+ */
+#define MAX_CLIP_RECTS 64
+
+/* Build and install the mask.  Runs on the main thread, after the frame change
+   that was queued before it, so [view bounds] is the size the mask will be
+   evaluated against.  Computing the path before the frame was applied used to
+   produce a mask built from the previous bounds: after a resize the punched
+   holes stayed where the panes used to be and the part of the view outside the
+   old rectangle had no mask at all. */
+static void apply_view_clip(WineContentView *view, CGRect *rects, unsigned int count,
+                            int surface_width, int surface_height, bool disjoint)
+{
+    CGRect kept[MAX_CLIP_RECTS], bounds = NSRectToCGRect([view bounds]);
+    CGMutablePathRef path;
+    CAShapeLayer* mask;
+    double sx, sy;
+    unsigned int i, j, n = 0;
+
+    if (bounds.size.width <= 0 || bounds.size.height <= 0) return;
+    sx = bounds.size.width / surface_width;
+    sy = bounds.size.height / surface_height;
+
+    /* Merge intersecting rectangles so the even-odd fill below cannot cancel
+       overlapping areas out (a pane and its child control are the same rect). */
+    for (i = 0; !disjoint && i < count && n < MAX_CLIP_RECTS; i++)
+    {
+        CGRect r = rects[i];
+
+        for (j = 0; j < n; )
+        {
+            if (CGRectIntersectsRect(kept[j], r))
+            {
+                r = CGRectUnion(kept[j], r);
+                kept[j] = kept[--n];
+                j = 0;
+            }
+            else j++;
+        }
+        kept[n++] = r;
+    }
+
+    path = CGPathCreateMutable();
+    CGPathAddRect(path, NULL, bounds);
+    for (i = 0; i < (disjoint ? count : n); i++)
+    {
+        CGRect r = disjoint ? rects[i] : kept[i];
+        CGRect scaled = CGRectMake(r.origin.x * sx, r.origin.y * sy,
+                                   r.size.width * sx, r.size.height * sy);
+        CGPathAddRect(path, NULL, scaled);
+    }
+
+    mask = [CAShapeLayer layer];
+    mask.path = path;
+    mask.fillRule = kCAFillRuleEvenOdd;
+    mask.frame = bounds;
+    /* The path lives in layer coordinates, so the geometry is scale independent,
+       but the mask is rasterised at its own contentsScale: leaving it at 1.0 on a
+       Retina view softens every hole edge to half a point. */
+    mask.contentsScale = view.layer.contentsScale;
+
+    view.layer.mask = mask;
+    CGPathRelease(path);
+}
+
+void macdrv_set_view_clip(macdrv_view v, const CGRect *rects, unsigned int count,
+                          int surface_width, int surface_height, bool disjoint)
+{
+@autoreleasepool
+{
+    WineContentView* view = (WineContentView*)v;
+    CGRect *copy;
+
+    if (!count)
+    {
+        OnMainThreadAsync(^{
+            view.layer.mask = nil;
+        });
+        return;
+    }
+
+    if (!surface_width || !surface_height) return;
+
+    /* The caller frees its array as soon as this returns, so the block needs
+       its own copy. */
+    if (!(copy = malloc(count * sizeof(*copy)))) return;
+    memcpy(copy, rects, count * sizeof(*copy));
+
+    OnMainThreadAsync(^{
+        apply_view_clip(view, copy, count, surface_width, surface_height, disjoint);
+        free(copy);
+    });
+}
+}
