+/* Opt-in geometry experiment, preserving patch A's Cocoa lifecycle. */
+#include "gl_clip_region.h"
+
+static BOOL gl_clip_screen_rect(HWND hwnd, UINT dpi, RECT *rect)
+{
+    if (!NtUserGetClientRect(hwnd, rect, dpi)) return FALSE;
+    NtUserMapWindowPoints(hwnd, 0, (POINT *)rect, 2, dpi);
+    return TRUE;
+}
+
+static BOOL gl_clip_subtract_window(struct gl_clip_region *visible, HWND hwnd,
+                                    RECT origin, UINT dpi)
+{
+    RECT rect;
+    if (!NtUserIsWindowVisible(hwnd)) return TRUE;
+    if (NtUserGetWindowLongW(hwnd, GWL_EXSTYLE) & WS_EX_TRANSPARENT) return TRUE;
+    if (!NtUserGetWindowRect(hwnd, &rect, dpi)) return FALSE;
+    OffsetRect(&rect, -origin.left, -origin.top);
+    return gl_clip_subtract(visible, rect);
+}
+
+/* Calculate exact holes without changing surface construction, ordering or
+ * refresh cadence.  Hidden or transient HWNDs use the known A path. */
+static BOOL update_gl_clip_exact(struct macdrv_client_surface *surface, HWND hwnd, UINT dpi)
+{
+    struct gl_clip_region visible = {0}, holes = {0};
+    HWND root = NtUserGetAncestor(hwnd, GA_ROOT), win = hwnd, parent, other;
+    RECT client, origin, rect;
+    CGRect *clip = NULL;
+    size_t i;
+    BOOL ret = FALSE;
+
+    if (!root || !dpi || !NtUserIsWindowVisible(hwnd) ||
+        !NtUserGetClientRect(hwnd, &client, dpi) || gl_clip_empty_rect(client) ||
+        !gl_clip_screen_rect(hwnd, dpi, &origin)) goto done;
+    if (!gl_clip_push(&visible, client)) goto done;
+
+    for (other = NtUserGetWindowRelative(hwnd, GW_CHILD); other && visible.count;
+         other = NtUserGetWindowRelative(other, GW_HWNDNEXT))
+        if (!gl_clip_subtract_window(&visible, other, origin, dpi)) goto done;
+
+    while (win != root && visible.count)
+    {
+        parent = NtUserGetAncestor(win, GA_PARENT);
+        if (!parent || parent == win || parent == NtUserGetDesktopWindow()) goto done;
+        if (!gl_clip_screen_rect(parent, dpi, &rect)) goto done;
+        OffsetRect(&rect, -origin.left, -origin.top);
+        gl_clip_intersect(&visible, rect);
+        for (other = NtUserGetWindowRelative(win, GW_HWNDPREV); other && visible.count;
+             other = NtUserGetWindowRelative(other, GW_HWNDPREV))
+            if (!gl_clip_subtract_window(&visible, other, origin, dpi)) goto done;
+        win = parent;
+    }
+
+    if (!gl_clip_complement(&holes, client, &visible)) goto done;
+    if (holes.count)
+    {
+        if (!(clip = malloc(holes.count * sizeof(*clip)))) goto done;
+        for (i = 0; i < holes.count; i++)
+        {
+            RECT r = holes.rects[i];
+            clip[i] = CGRectMake(r.left, r.top, r.right - r.left, r.bottom - r.top);
+        }
+    }
+    macdrv_set_view_clip(surface->cocoa_view, clip, holes.count,
+                         client.right - client.left, client.bottom - client.top, true);
+    TRACE("V3 exact clip hwnd %p visible %zu holes %zu\n", hwnd, visible.count, holes.count);
+    ret = TRUE;
+
+done:
+    free(clip);
+    gl_clip_clear(&holes);
+    gl_clip_clear(&visible);
+    return ret;
+}
+
+/* The GL view is composited above the window surface, which also holds the pixels of every
+   window of the toplevel.  A window that is above this one in Z order must therefore be
+   punched out of the view, otherwise it is covered by the OpenGL frame.  Only windows of
+   this toplevel are considered: other toplevels have their own surface. */
+#define MAX_ABOVE_RECTS 64
+
+static UINT collect_above_rects(HWND hwnd, RECT *rects, UINT max, UINT dpi)
+{
+    HWND root = NtUserGetAncestor(hwnd, GA_ROOT);
+    HWND win = hwnd, sib, child;
+    RECT client, rect;
+    UINT count = 0;
+
+    if (!root || !NtUserGetClientRect(hwnd, &client, dpi)) return 0;
+
+    for (;;)
+    {
+        /* children are always drawn above their parent */
+        if (win == hwnd)
+            for (child = NtUserGetWindowRelative(hwnd, GW_CHILD); child;
+                 child = NtUserGetWindowRelative(child, GW_HWNDNEXT))
+            {
+                if (count == max) return count;
+                if (!NtUserIsWindowVisible(child) || !NtUserGetWindowRect(child, &rect, dpi)) continue;
+                NtUserMapWindowPoints(0, hwnd, (POINT *)&rect, 2, dpi);
+                if (rect.left >= client.right || rect.right <= client.left ||
+                    rect.top >= client.bottom || rect.bottom <= client.top) continue;
+                rects[count++] = rect;
+            }
+
+        if (win == root) break;
+
+        /* siblings above this window, and their children, are above it as well; this also
+           covers a docked pane that hosts the control (the FeatureManager tree) */
+        for (sib = NtUserGetWindowRelative(win, GW_HWNDPREV); sib;
+             sib = NtUserGetWindowRelative(sib, GW_HWNDPREV))
+        {
+            if (count == max) return count;
+            if (NtUserIsWindowVisible(sib) && NtUserGetWindowRect(sib, &rect, dpi))
+            {
+                NtUserMapWindowPoints(0, hwnd, (POINT *)&rect, 2, dpi);
+                if (rect.left < client.right && rect.right > client.left &&
+                    rect.top < client.bottom && rect.bottom > client.top)
+                    rects[count++] = rect;
+            }
+            for (child = NtUserGetWindowRelative(sib, GW_CHILD); child;
+                 child = NtUserGetWindowRelative(child, GW_HWNDNEXT))
+            {
+                if (count == max) return count;
+                if (!NtUserIsWindowVisible(child) || !NtUserGetWindowRect(child, &rect, dpi)) continue;
+                NtUserMapWindowPoints(0, hwnd, (POINT *)&rect, 2, dpi);
+                if (rect.left >= client.right || rect.right <= client.left ||
+                    rect.top >= client.bottom || rect.bottom <= client.top) continue;
+                rects[count++] = rect;
+            }
+        }
+
+        win = NtUserGetAncestor(win, GA_PARENT);
+    }
+
+    return count;
+}
+
+static void update_gl_clip(struct macdrv_client_surface *surface, HWND hwnd)
+{
+    RECT above[MAX_ABOVE_RECTS], client_rect;
+    CGRect clip[MAX_ABOVE_RECTS];
+    UINT dpi = NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI);
+    UINT i, count;
+    const char *exact = getenv("WINEMAC_GL_CLIP_V3");
+
+    if (exact && !strcmp(exact, "1"))
+    {
+        if (update_gl_clip_exact(surface, hwnd, dpi)) return;
+        TRACE("V3 exact clip unavailable for hwnd %p, using A\n", hwnd);
+    }
+    count = collect_above_rects(hwnd, above, MAX_ABOVE_RECTS, dpi);
+    for (i = 0; i < count; i++)
+        clip[i] = CGRectMake(above[i].left, above[i].top,
+                             above[i].right - above[i].left,
+                             above[i].bottom - above[i].top);
+    if (!NtUserGetClientRect(hwnd, &client_rect, dpi)) count = 0;
+    macdrv_set_view_clip(surface->cocoa_view, clip, count, client_rect.right, client_rect.bottom, false);
+}
