+/* Rectangular visible-region geometry for the macOS OpenGL compositor.
+ * This library is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2.1 or any later version.
+ * RECT must be declared by the including translation unit.
+ */
+#ifndef __WINE_MACDRV_GL_CLIP_REGION_H
+#define __WINE_MACDRV_GL_CLIP_REGION_H
+
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Fail open on unusually complex geometry rather than silently dropping holes. */
+#define GL_CLIP_REGION_LIMIT 16384u
+
+struct gl_clip_region
+{
+    RECT *rects;
+    size_t count, capacity;
+};
+
+static inline bool gl_clip_empty_rect(RECT r)
+{
+    return r.left >= r.right || r.top >= r.bottom;
+}
+
+static inline RECT gl_clip_intersection(RECT a, RECT b)
+{
+    RECT r = {a.left > b.left ? a.left : b.left,
+              a.top > b.top ? a.top : b.top,
+              a.right < b.right ? a.right : b.right,
+              a.bottom < b.bottom ? a.bottom : b.bottom};
+    return r;
+}
+
+static inline bool gl_clip_push(struct gl_clip_region *r, RECT rect)
+{
+    if (gl_clip_empty_rect(rect)) return true;
+    if (r->count == r->capacity)
+    {
+        size_t capacity = r->capacity ? r->capacity * 2 : 8;
+        RECT *new_rects;
+        if (capacity > GL_CLIP_REGION_LIMIT) return false;
+        if (!(new_rects = realloc(r->rects, capacity * sizeof(*new_rects)))) return false;
+        r->rects = new_rects;
+        r->capacity = capacity;
+    }
+    r->rects[r->count++] = rect;
+    return true;
+}
+
+static inline void gl_clip_clear(struct gl_clip_region *r)
+{
+    free(r->rects);
+    memset(r, 0, sizeof(*r));
+}
+
+static inline void gl_clip_intersect(struct gl_clip_region *r, RECT rect)
+{
+    size_t i, n = 0;
+    for (i = 0; i < r->count; i++)
+    {
+        RECT hit = gl_clip_intersection(r->rects[i], rect);
+        if (!gl_clip_empty_rect(hit)) r->rects[n++] = hit;
+    }
+    r->count = n;
+}
+
+/* Subtract a rectangle exactly.  Each original rectangle splits into up to
+ * four disjoint rectangles.  Newly appended rectangles cannot intersect
+ * the cut, so only the original entries need processing. */
+static inline bool gl_clip_subtract(struct gl_clip_region *r, RECT cut)
+{
+    size_t i, old_count = r->count, n = 0;
+    if (gl_clip_empty_rect(cut)) return true;
+    for (i = 0; i < old_count; i++)
+    {
+        RECT a = r->rects[i], hit = gl_clip_intersection(a, cut);
+        if (gl_clip_empty_rect(hit)) continue;
+        r->rects[i] = (RECT){a.left, a.top, a.right, hit.top};
+        if (!gl_clip_push(r, (RECT){a.left, hit.bottom, a.right, a.bottom}) ||
+            !gl_clip_push(r, (RECT){a.left, hit.top, hit.left, hit.bottom}) ||
+            !gl_clip_push(r, (RECT){hit.right, hit.top, a.right, hit.bottom})) return false;
+    }
+    for (i = 0; i < r->count; i++)
+        if (!gl_clip_empty_rect(r->rects[i])) r->rects[n++] = r->rects[i];
+    r->count = n;
+    return true;
+}
+
+static inline bool gl_clip_same_rect(RECT a, RECT b)
+{
+    return a.left == b.left && a.top == b.top && a.right == b.right && a.bottom == b.bottom;
+}
+
+static inline bool gl_clip_equal(const struct gl_clip_region *a, const struct gl_clip_region *b)
+{
+    size_t i;
+    if (a->count != b->count) return false;
+    for (i = 0; i < a->count; i++)
+        if (!gl_clip_same_rect(a->rects[i], b->rects[i])) return false;
+    return true;
+}
+
+/* Complement of a visible region within the original client.  The A
+ * compositor expects holes, not visible rectangles.  An entirely hidden
+ * drawable consequently produces one full-client hole, not an empty path. */
+static inline bool gl_clip_complement(struct gl_clip_region *holes, RECT client,
+                                      const struct gl_clip_region *visible)
+{
+    size_t i;
+    holes->count = 0;
+    if (!gl_clip_push(holes, client)) return false;
+    for (i = 0; i < visible->count && holes->count; i++)
+        if (!gl_clip_subtract(holes, visible->rects[i])) return false;
+    return true;
+}
+
+#endif
