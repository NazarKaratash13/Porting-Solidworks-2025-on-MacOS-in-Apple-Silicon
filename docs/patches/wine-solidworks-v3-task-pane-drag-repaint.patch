+HWND sw_track_taskpane_splitter( HWND hwnd, RECT *damage )
+{
+    HWND frame;
+
+    if (!sw_taskpane_layout_enabled() || !(frame = sw_taskpane_geometry_frame( hwnd )) ||
+        !sw_taskpane_header_rect( frame, damage )) return 0;
+    return frame;
+}
+
+void sw_repaint_taskpane_splitter( HWND frame, const RECT *damage )
+{
+    RECT exposed = *damage, client;
+
+    sw_erase_old_taskpane_header( frame, exposed );
+    map_window_points( 0, frame, (POINT *)&exposed, 2, get_thread_dpi() );
+    if (!get_client_rect( frame, &client, get_thread_dpi() ) ||
+        !intersect_rect( &exposed, &exposed, &client )) return;
+    NtUserRedrawWindow( frame, &exposed, NULL, RDW_INVALIDATE | RDW_ERASE | RDW_ALLCHILDREN );
+}
