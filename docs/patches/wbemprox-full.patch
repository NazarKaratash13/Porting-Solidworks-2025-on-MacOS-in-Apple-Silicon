--- a/dlls/wbemprox/wbemtrace.h	1970-01-01 02:00:00
+++ b/dlls/wbemprox/wbemtrace.h	2026-11-23 18:24:12
@@ -0,0 +1,35 @@
+/*
+ * Diagnostic tracing for Wine Bug 59476 (SOLIDWORKS physical footprint).
+ *
+ * Build with -DWBEMPROX_TRACE to enable the WMI/BSTR accounting described in
+ * dlls/ntdll/bstrtrace.h. Without that define every hook below expands to
+ * nothing, so the module compiles and behaves exactly as upstream and no
+ * tracing code is present in the binary at all.
+ *
+ * The tracing is a development aid only; it must never be enabled in a
+ * shipped build.
+ */
+
+#ifndef __WINE_WBEMPROX_WBEMTRACE_H
+#define __WINE_WBEMPROX_WBEMTRACE_H
+
+#ifdef WBEMPROX_TRACE
+
+#define BT_ONLY_PROPS
+#define BT_WANT_PROPS
+#define BT_WANT_WMI
+#include "../ntdll/bstrtrace.h"
+
+#else /* !WBEMPROX_TRACE */
+
+#define bt_prop_hit( name, hr, vt, tag )        ((void)0)
+#define bt_prop_snap()                          ((void)0)
+#define wm_note_get( cls, prop, len, vt, pv, i ) ((void)0)
+#define wm_tick()                               ((void)0)
+#define wm_reset()                              ((void)0)
+#define wm_next_result( hr, returned )          ((void)0)
+#define wm_object()                             ((void)0)
+
+#endif /* WBEMPROX_TRACE */
+
+#endif /* __WINE_WBEMPROX_WBEMTRACE_H */
