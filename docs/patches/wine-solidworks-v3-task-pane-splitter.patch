+static HWND sw_taskpane_geometry_frame( HWND hwnd )
+{
+    static const WCHAR em_frame[] = {'E','M',' ','F','r','a','m','e',0};
+    static const WCHAR header[] = {'h','e','a','d','e','r',0};
+    WCHAR title[32];
+    DWORD_PTR id = get_window_long( hwnd, GWLP_ID );
+
+    if (id != 59421 && id != 59465 && !sw_is_auto_hider( hwnd ) &&
+        !(NtUserInternalGetWindowText( hwnd, title, ARRAY_SIZE(title) ) &&
+          (!wcscmp( title, em_frame ) || !wcscmp( title, header )))) return 0;
+
+    return sw_taskpane_window( hwnd ) ? NtUserGetAncestor( hwnd, GA_ROOT ) : 0;
 }
 
