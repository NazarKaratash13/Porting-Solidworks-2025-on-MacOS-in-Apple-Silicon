+
+enum { SwSaveFormatTag = 7031, SwSaveModeTag };
+
+static NSPopUpButton *sw_save_option(NSView *view, NSString *title, CGFloat y)
+{
+    NSTextField *label = [NSTextField labelWithString:title];
+    NSPopUpButton *popup = [[[NSPopUpButton alloc]
+                           initWithFrame:NSMakeRect(112, y, 285, 25) pullsDown:NO] autorelease];
+
+    label.frame = NSMakeRect(8, y + 4, 104, 19);
+    [view addSubview:label];
+    [view addSubview:popup];
+    popup.accessibilityLabel = title;
+    return popup;
+}
+
+static NSView *sw_save_options(NSInteger kind, NSString *nativeExtension, id target)
+{
+    NSView *view = [[[NSView alloc] initWithFrame:NSMakeRect(0, 0, 406, 64)] autorelease];
+    NSPopUpButton *formats = sw_save_option(view, @"Формат", 34);
+    NSPopUpButton *mode = sw_save_option(view, @"Действие", 4);
+    NSArray *entries;
+
+    [formats addItemWithTitle:[NSString stringWithFormat:@"SOLIDWORKS (*.%@)", nativeExtension]];
+    formats.lastItem.representedObject = nativeExtension;
+    if (kind == 3)
+        entries = @[@[@"PDF (*.pdf)", @"pdf"], @[@"DXF (*.dxf)", @"dxf"], @[@"DWG (*.dwg)", @"dwg"]];
+    else
+        entries = @[@[@"STEP (*.step)", @"step"], @[@"IGES (*.igs)", @"igs"],
+                    @[@"Parasolid (*.x_t)", @"x_t"], @[@"STL (*.stl)", @"stl"]];
+
+    for (NSArray *entry in entries)
+    {
+        [formats addItemWithTitle:entry[0]];
+        formats.lastItem.representedObject = entry[1];
+    }
+    formats.tag = SwSaveFormatTag;
+    formats.target = target;
+    formats.action = @selector(swSelectSaveFormat:);
+
+    [mode addItemsWithTitles:@[@"Сохранить как", @"Сохранить копию и продолжить",
+                               @"Сохранить копию и открыть"]];
+    [mode itemAtIndex:1].tag = 2;
+    [mode itemAtIndex:2].tag = 512;
+    mode.tag = SwSaveModeTag;
+    return view;
 }
 
