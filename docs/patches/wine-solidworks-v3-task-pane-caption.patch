+/* The custom-drawn caption shares its window with three child controls.
+ * Reserve their actual bounds in the header's client coordinate system. */
+BOOL sw_taskpane_caption_clip( HWND hwnd, RECT *clip )
+{
+    static const WCHAR name[] = {'h','e','a','d','e','r',0};
+    WCHAR title[16];
+    UINT dpi = get_dpi_for_window( hwnd );
+    HWND child;
+    RECT button;
+    LONG center, margin;
+
+    if (!sw_taskpane_layout_enabled() ||
+        !NtUserInternalGetWindowText( hwnd, title, ARRAY_SIZE(title) ) ||
+        wcscmp( title, name ) || !sw_taskpane_window( hwnd ) ||
+        !get_client_rect( hwnd, clip, dpi )) return FALSE;
+
+    center = (clip->left + clip->right) / 2;
+    margin = max( 2, muldiv( 5, dpi, 96 ) );
+    for (child = NtUserGetWindowRelative( hwnd, GW_CHILD ); child;
+         child = NtUserGetWindowRelative( child, GW_HWNDNEXT ))
+    {
+        if (!NtUserIsWindowVisible( child ) || !get_window_rect( child, &button, dpi ) ||
+            IsRectEmpty( &button )) continue;
+        map_window_points( 0, hwnd, (POINT *)&button, 2, dpi );
+        if (button.top >= clip->bottom || button.bottom <= clip->top) continue;
+        if ((button.left + button.right) / 2 < center) clip->left = max( clip->left, button.right + margin );
+        else clip->right = min( clip->right, button.left - margin );
+    }
+    return TRUE;
+}
