+static NSURL *sw_file_directory(NSString *documentPath)
+{
+    if ([documentPath hasPrefix:@"Z:\\"])
+    {
+        NSString *hostPath = [[documentPath substringFromIndex:2]
+                              stringByReplacingOccurrencesOfString:@"\\" withString:@"/"];
+        return [NSURL fileURLWithPath:[hostPath stringByDeletingLastPathComponent]];
+    }
+    NSString *folder = [NSHomeDirectory() stringByAppendingPathComponent:@"SOLIDWORKS Files"];
+    return [[NSFileManager defaultManager] fileExistsAtPath:folder] ? [NSURL fileURLWithPath:folder] : nil;
 }
 
