+    - (void)application:(NSApplication *)application openFiles:(NSArray *)paths
+    {
+        if (sw_files_enabled())
+        {
+            fprintf(stderr, "SOLIDWORKS V3: Finder documents: %lu\n", (unsigned long)[paths count]);
+            sw_open_mac_paths(paths, TRUE);
+        }
+        else [application replyToOpenOrPrint:NSApplicationDelegateReplyFailure];
+    }
+
+    - (void)swOpenMacFiles:(id)sender
+    {
+        NSOpenPanel *panel = [NSOpenPanel openPanel];
+        panel.allowedFileTypes = @[@"sldprt", @"sldasm", @"slddrw"];
+        panel.allowsMultipleSelection = YES;
+        [panel beginWithCompletionHandler:^(NSModalResponse result) {
+            if (result == NSModalResponseOK) sw_open_mac_paths([panel.URLs valueForKey:@"path"], FALSE);
+        }];
+    }
+
+    - (void)swSaveMacFile:(id)sender
+    {
+        sw_run_file_bridge(@[@"active"], ^(BOOL success, NSString *detail) {
+            NSArray *lines = [detail componentsSeparatedByString:@"\n"];
+            NSInteger kind = [lines count] >= 3 ? [[lines objectAtIndex:0] integerValue] : 0;
+            if (!success || kind < 1 || kind > 3)
+            {
+                sw_file_error(@"Нет активной детали, сборки или чертежа.", detail);
+                return;
+            }
+            NSString *extension = [@[@"sldprt", @"sldasm", @"slddrw"] objectAtIndex:kind - 1];
+            NSString *title = [lines objectAtIndex:1];
+            NSString *documentPath = [lines objectAtIndex:2];
+            NSSavePanel *panel = [NSSavePanel savePanel];
+            panel.allowedFileTypes = @[extension];
+            panel.canCreateDirectories = YES;
+            panel.nameFieldStringValue = sw_supported_file(title) ? [title stringByDeletingPathExtension] : title;
+            if ([documentPath hasPrefix:@"Z:\\"])
+            {
+                NSString *hostPath = [[documentPath substringFromIndex:2]
+                                      stringByReplacingOccurrencesOfString:@"\\" withString:@"/"];
+                panel.directoryURL = [NSURL fileURLWithPath:[hostPath stringByDeletingLastPathComponent]];
+            }
+            else
+            {
+                NSString *folder = [NSHomeDirectory() stringByAppendingPathComponent:@"SOLIDWORKS Files"];
+                if ([[NSFileManager defaultManager] fileExistsAtPath:folder])
+                    panel.directoryURL = [NSURL fileURLWithPath:folder];
+            }
+            [panel beginWithCompletionHandler:^(NSModalResponse result) {
+                if (result != NSModalResponseOK) return;
+                NSString *path = sw_windows_path(panel.URL.path);
+                if (!path)
+                {
+                    sw_file_error(@"Этот путь нельзя передать SOLIDWORKS.", nil);
+                    return;
+                }
+                sw_run_file_bridge(@[@"save", path, title, documentPath], ^(BOOL saved, NSString *error) {
+                    if (!saved) sw_file_error(@"SOLIDWORKS не подтвердил сохранение.", error);
+                });
+            }];
+        });
     }
 
