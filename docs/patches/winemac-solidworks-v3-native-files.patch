+#include <unistd.h>
+
+/* These native file commands belong to the local SOLIDWORKS V3 bundle. */
+static BOOL sw_files_enabled(void)
+{
+    const char *pid = getenv("WINEMAC_SW_FILES_PID");
+    char process[32];
+
+    snprintf(process, sizeof(process), "%d", getpid());
+    return pid && !strcmp(pid, process);
+}
+
+static void sw_install_file_menu(NSMenu *menu, id target)
+{
+    NSMenu *fileMenu;
+    NSMenuItem *fileItem;
+
+    if (!sw_files_enabled() || !menu || [menu itemWithTitle:@"Файлы Mac"]) return;
+    fileMenu = [[[NSMenu alloc] initWithTitle:@"Файлы Mac"] autorelease];
+    fileItem = [fileMenu addItemWithTitle:@"Открыть на Mac…" action:@selector(swOpenMacFiles:) keyEquivalent:@"o"];
+    fileItem.target = target;
+    fileItem = [fileMenu addItemWithTitle:@"Сохранить как на Mac…" action:@selector(swSaveMacFile:) keyEquivalent:@"s"];
+    fileItem.target = target;
+    fileItem.keyEquivalentModifierMask = NSEventModifierFlagCommand | NSEventModifierFlagShift;
+    fileItem = [[[NSMenuItem alloc] init] autorelease];
+    fileItem.title = @"Файлы Mac";
+    fileItem.submenu = fileMenu;
+    [menu addItem:fileItem];
+}
+
+static NSString *sw_windows_path(NSString *path)
+{
+    if (![path isAbsolutePath] || [path rangeOfCharacterFromSet:
+        [NSCharacterSet characterSetWithCharactersInString:@":\\\n\r"]].location != NSNotFound) return nil;
+    return [@"Z:" stringByAppendingString:[path stringByReplacingOccurrencesOfString:@"/" withString:@"\\"]];
+}
+
+static BOOL sw_supported_file(NSString *path)
+{
+    static NSArray *extensions;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        extensions = [@[@"sldprt", @"sldasm", @"slddrw"] retain];
+    });
+    return [extensions containsObject:[[path pathExtension] lowercaseString]];
+}
+
+static void sw_file_error(NSString *message, NSString *detail)
+{
+    NSAlert *alert = [[[NSAlert alloc] init] autorelease];
+    alert.messageText = message;
+    if ([detail length]) alert.informativeText = detail;
+    [alert runModal];
+}
+
+/* The helper attaches only to the ROT inside this prefix. It never starts SOLIDWORKS. */
+static void sw_run_file_bridge(NSArray *arguments, void (^completion)(BOOL, NSString *))
+{
+    static dispatch_queue_t queue;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        queue = dispatch_queue_create("local.solidworks2025.file-bridge", DISPATCH_QUEUE_SERIAL);
+    });
+    dispatch_async(queue, ^{
+        @autoreleasepool
+        {
+            NSTask *task = [[[NSTask alloc] init] autorelease];
+            NSPipe *pipe = [NSPipe pipe];
+            NSMutableDictionary *env = [NSMutableDictionary dictionaryWithDictionary:
+                                       [[NSProcessInfo processInfo] environment]];
+            NSString *runtime = [env objectForKey:@"CX_ROOT"];
+            NSString *prefix = [env objectForKey:@"WINEPREFIX"];
+            NSError *error = nil;
+            NSData *data = nil;
+            BOOL success = FALSE;
+            NSString *detail;
+
+            if (runtime && prefix)
+            {
+                [env setObject:@"-all" forKey:@"WINEDEBUG"];
+                task.environment = env;
+                task.executableURL = [NSURL fileURLWithPath:[runtime
+                                     stringByAppendingPathComponent:@"lib/wine/x86_64-unix/wine"]];
+                task.currentDirectoryURL = [NSURL fileURLWithPath:[prefix stringByAppendingPathComponent:@"drive_c"]];
+                task.arguments = [@[@"C:\\sw-v3\\file-bridge.exe"] arrayByAddingObjectsFromArray:arguments];
+                task.standardOutput = pipe;
+                if ([task launchAndReturnError:&error])
+                {
+                    data = [[pipe fileHandleForReading] readDataToEndOfFile];
+                    [task waitUntilExit];
+                    success = task.terminationStatus == 0;
+                }
+            }
+            detail = data ? [[[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding] autorelease] :
+                            (error.localizedDescription ?: @"Wine недоступен.");
+            detail = [detail stringByReplacingOccurrencesOfString:@"\r" withString:@""];
+            dispatch_async(dispatch_get_main_queue(), ^{ completion(success, detail); });
+        }
+    });
+}
+
+static void sw_open_mac_paths(NSArray *paths, BOOL apple_event)
+{
+    NSMutableArray *args = [NSMutableArray arrayWithObject:@"open"];
+    for (NSString *path in paths)
+    {
+        NSString *windows_path = sw_windows_path(path);
+        if (windows_path && sw_supported_file(path)) [args addObject:windows_path];
+    }
+
+    if ([args count] != [paths count] + 1 || [paths count] == 0)
+    {
+        if (apple_event) [NSApp replyToOpenOrPrint:NSApplicationDelegateReplyFailure];
+        else sw_file_error(@"Поддерживаются файлы SLDPRT, SLDASM и SLDDRW.", nil);
+        return;
+    }
+    sw_run_file_bridge(args, ^(BOOL success, NSString *detail) {
+        if (apple_event) [NSApp replyToOpenOrPrint:success ? NSApplicationDelegateReplySuccess :
+                                                        NSApplicationDelegateReplyFailure];
+        if (!success) sw_file_error(@"Не удалось открыть документ в SOLIDWORKS.", detail);
+    });
+}
