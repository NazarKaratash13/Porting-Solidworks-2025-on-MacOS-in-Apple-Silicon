+
+/* The dock handles its splitter in its own message loop. Retain the swept
+ * header band until that loop has processed its last mouse-up and layout. */
+static __thread struct
+{
+    HWND dock;
+    HWND frame;
+    RECT damage;
+    BOOL moved;
+} sw_docked_taskpane_drag;
+
+void sw_begin_docked_taskpane_drag( HWND hwnd )
+{
+    HWND frame;
+    RECT rect;
+
+    if (!sw_taskpane_layout_enabled() || get_window_long( hwnd, GWLP_ID ) != 59465 ||
+        !(frame = sw_track_taskpane_splitter( hwnd, &rect ))) return;
+    sw_docked_taskpane_drag.dock = hwnd;
+    sw_docked_taskpane_drag.frame = frame;
+    sw_docked_taskpane_drag.damage = rect;
+    sw_docked_taskpane_drag.moved = FALSE;
+}
+
+void sw_post_docked_taskpane_release( HWND hwnd )
+{
+    if (!hwnd || sw_docked_taskpane_drag.dock != hwnd) return;
+    sw_docked_taskpane_drag.dock = 0;
+    NtUserPostMessage( sw_docked_taskpane_drag.frame, SW_TASKPANE_DRAG_RELEASED, 0, 0 );
+}
+
+void sw_finish_docked_taskpane_drag( HWND frame )
+{
+    RECT damage;
+
+    if (sw_docked_taskpane_drag.dock || sw_docked_taskpane_drag.frame != frame) return;
+    damage = sw_docked_taskpane_drag.damage;
+    sw_docked_taskpane_drag.frame = 0;
+    if (!sw_docked_taskpane_drag.moved || IsRectEmpty( &damage )) return;
+    damage.left -= max( 2, muldiv( 2, get_thread_dpi(), 96 ) );
+    sw_invalidate_old_taskpane_header( frame, damage, RDW_UPDATENOW );
 }
 
